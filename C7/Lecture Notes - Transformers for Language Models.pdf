          "iopub.status.idle": "2024-09-12T07:44:42.208484Z",
          "shell.execute_reply": "2024-09-12T07:44:42.207778Z",
          "shell.execute_reply.started": "2024-09-12T07:44:42.195651Z"
        },
        "id": "vanilla-symposium",
        "trusted": true
      },
      "outputs": [],
      "source": [
        "def translate(sentence, plotgraph):\n",
        "  result, sentence, attention_plot = evaluate(sentence)\n",
        "  print('Input: %s' % (sentence))\n",
        "  print('Predicted translation: {}'.format(result))\n",
        "  attention_plot = attention_plot[:len(result.split(' ')), :len(sentence.split(' '))]\n",
        "  if plotgraph:\n",
        "      plot_attention(attention_plot, sentence.split(' '), result.split(' '))\n",
        "\n",
        "  return result"
      ]
    },
