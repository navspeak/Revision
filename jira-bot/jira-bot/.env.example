# Copy this file to ".env" (same folder) and fill in what you want. ".env" is git-ignored.
# Real environment variables override this file; this file overrides settings saved in the app.

# Jira
JIRABOT_JIRA_SITE=mycompany.atlassian.net
JIRABOT_JIRA_EMAIL=you@mycompany.com
# Used only by the "Log in" button in Settings (leave the token box empty). Passed to ACLI on
# stdin, never saved by the app. JIRA_API_TOKEN also works.
JIRABOT_JIRA_API_TOKEN=

# Copilot CLI
JIRABOT_COPILOT_COMMAND=copilot
JIRABOT_COPILOT_MODEL=
JIRABOT_COPILOT_EXTRA_ARGS=
JIRABOT_COPILOT_TIMEOUT=180
JIRABOT_MAX_PROMPT_CHARS=20000

# Atlassian CLI
JIRABOT_ACLI_COMMAND=acli
JIRABOT_ACLI_TIMEOUT=120

# Query defaults
JIRABOT_DEFAULT_LIMIT=50
JIRABOT_DEFAULT_FIELDS=
JIRABOT_SHARE_RESULTS=true
